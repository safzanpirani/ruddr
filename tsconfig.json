{
  "compilerOptions": {
    "target": "ESNext",
    "module": "Preserve",
    "moduleResolution": "Bundler",
    "strict": true,
    "skipLibCheck": true,
    "noEmit": true,
    "types": ["bun"]
  },
  "include": [
    "adapter/**/*.ts",
    "claude/**/*.ts",
    "opencode/**/*.ts",
    "pi/**/*.ts",
    "tui/**/*.ts",
    "web/**/*.ts"
  ]
}
