{
  "name": "ruddr",
  "version": "0.4.0",
  "description": "Thin control plane for Codex, Claude Code, OpenCode, and Pi agent sessions: run, steer, observe, and a live TUI with diffs.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ruddr": "bin/ruddr.cjs",
    "rudder": "bin/ruddr.cjs"
  },
  "files": [
    "bin/",
    "scripts/npm-binary.cjs",
    "scripts/npm-postinstall.cjs",
    "tui/",
    "adapter/",
    "claude/",
    "opencode/",
    "pi/",
    "skills/",
    "*.go",
    "go.mod",
    "go.sum",
    "checksums.json",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "!**/*.test.ts",
    "!*_test.go",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/safzanpirani/ruddr.git"
  },
  "homepage": "https://github.com/safzanpirani/ruddr#readme",
  "bugs": {
    "url": "https://github.com/safzanpirani/ruddr/issues"
  },
  "keywords": [
    "codex",
    "claude-code",
    "opencode",
    "agent",
    "tui",
    "cli"
  ],
  "scripts": {
    "tui": "bun run tui/index.ts",
    "test:tui": "bun test tui",
    "postinstall": "node scripts/npm-postinstall.cjs"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "0.3.245",
    "@opentui/core": "^0.5.8"
  },
  "devDependencies": {
    "@types/bun": "^1.3.5",
    "typescript": "^5.9.3"
  }
}
