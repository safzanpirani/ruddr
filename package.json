{
  "name": "ruddr",
  "version": "0.6.0",
  "description": "Thin control plane for Codex, Claude Code, OpenCode, Pi, and Factory Droid agent sessions: run, steer, observe, and a live TUI and web dashboard with diffs. One native binary.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "ruddr": "bin/ruddr.cjs",
    "rudder": "bin/ruddr.cjs"
  },
  "files": [
    "bin/",
    "scripts/npm-binary.cjs",
    "scripts/npm-postinstall.cjs",
    "skills/",
    "checksums.json",
    "README.md",
    "THIRD_PARTY_NOTICES.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/safzanpirani/ruddr.git"
  },
  "homepage": "https://github.com/safzanpirani/ruddr#readme",
  "bugs": {
    "url": "https://github.com/safzanpirani/ruddr/issues"
  },
  "keywords": [
    "codex",
    "claude-code",
    "opencode",
    "droid",
    "agent",
    "tui",
    "cli"
  ],
  "scripts": {
    "build:web": "bun scripts/build-web.ts",
    "test:web": "bun test web scripts",
    "postinstall": "node scripts/npm-postinstall.cjs"
  },
  "devDependencies": {
    "@pierre/diffs": "1.5.1",
    "@pierre/trees": "1.0.0-beta.6",
    "@types/bun": "^1.4.2",
    "typescript": "^5.9.3"
  }
}
